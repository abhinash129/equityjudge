package com.nivesh.bo;

import java.io.Serializable;
import java.util.Date;

public class LiveBSESensexBO implements Serializable{
	
	private static final long serialVersionUID = 1L;
	private String companyName;
	private Float current_Value;
	private Float prev_Close_Price;
	private Float chang_points;
	private Float change_per;
	private int volume;
	private Float turnOver;
	private Date auditDateTime;
	
	
	public Date getAuditDateTime() {
		return auditDateTime;
	}
	public void setAuditDateTime(Date auditDateTime) {
		this.auditDateTime = auditDateTime;
	}
	public String getCompanyName() {
		return companyName;
	}
	public void setCompanyName(String companyName) {
		this.companyName = companyName;
	}
	public Float getCurrent_Value() {
		return current_Value;
	}
	public void setCurrent_Value(Float current_Value) {
		this.current_Value = current_Value;
	}
	public Float getChang_points() {
		return chang_points;
	}
	public void setChang_points(Float chang_points) {
		this.chang_points = chang_points;
	}
	public Float getChange_per() {
		return change_per;
	}
	public void setChange_per(Float change_per) {
		this.change_per = change_per;
	}
	
	public int getVolume() {
		return volume;
	}
	public void setVolume(int volume) {
		this.volume = volume;
	}
	public Float getTurnOver() {
		return turnOver;
	}
	public void setTurnOver(Float turnOver) {
		this.turnOver = turnOver;
	}
	public Float getPrev_Close_Price() {
		return prev_Close_Price;
	}
	public void setPrev_Close_Price(Float prev_Close_Price) {
		this.prev_Close_Price = prev_Close_Price;
	}
	@Override
	public String toString() {
		return "LiveBSESensexBO [companyName=" + companyName + ", current_Value=" + current_Value
				+ ", prev_Close_Price=" + prev_Close_Price + ", chang_points=" + chang_points + ", change_per="
				+ change_per + ", volume=" + volume + ", turnOver=" + turnOver + ", auditDateTime=" + auditDateTime
				+ "]";
	}
	
	
	
	
}
