package com.nivesh.controller.graphpattern;

import java.text.ParseException;
import java.util.Date;
import java.util.List;
import java.util.Map;

import javax.annotation.Resource;
import javax.servlet.http.HttpServletRequest;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.ModelMap;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.ResponseBody;

import com.nivesh.bo.ActiveCompanyListBO;
import com.nivesh.bo.CompanyStockDetailsBO;
import com.nivesh.bo.DailyPatternReportBO;
import com.nivesh.bo.LiveBSESensexBO;
import com.nivesh.command.dashboard.GainerAndLosserCommand;
import com.nivesh.controller.login.LoginController;
import com.nivesh.service.company.ICompanyService;
import com.nivesh.service.dashboard.IDashboardServices;
import com.nivesh.service.portfolio.IPortfoliodataService;
import com.nivesh.util.ICache;

@Controller
@RequestMapping("/graphpattern")
public class GraphController {

	public static final String GAINER_OR_LOSER_DISPLAY="gainerORloserDisplay", DISPLAYGRAPH="displaygraph", SUGGESTIONREPORT="report", 
			LATESTPATTERNREPORT="latestpatternreport",DISPLAYGRAPHDETAILS="displaygraphdetails",DISPLAYGRAPHDETAILSLIST="displaygraphdetailsList";

	@Autowired	
	ICompanyService icompanyService;

	@Resource(name="parameterCache")
	ICache icache;

	@Autowired
	IDashboardServices iDashboardServices;

	
	@Autowired
	IPortfoliodataService iPortfoliodataService;
	
	@RequestMapping(value="/graph/home",method=RequestMethod.GET)
	public String graphpatten(ModelMap map,HttpServletRequest request) throws ParseException{
		
		ActiveCompanyListBO activeCompanyListBO =  icompanyService.getsc_codeBaseCompanyName(LoginController.FIRSTGRAPHCOMPANY);
		
		map.addAttribute("FirstCompny", activeCompanyListBO);

		List<LiveBSESensexBO> liveBSEList = icompanyService.getTickerData();
		map.addAttribute("BSESensexValue" ,liveBSEList.get(liveBSEList.size()-1));
		map.addAttribute("LiveBSE", liveBSEList);
		map.addAttribute("gainerAndLosserCommand", new GainerAndLosserCommand());

		return DISPLAYGRAPH;

	}

	@RequestMapping(value="/graph/selectCompny",method=RequestMethod.GET)
	public String CompnyGraph(@RequestParam("companyName") String companyName,ModelMap map) throws ParseException{
		
		ActiveCompanyListBO activeCompanyListBO =  icompanyService.getsc_codeBaseCompanyName(companyName);
  		map.addAttribute("FirstCompny", activeCompanyListBO);
		
		List<LiveBSESensexBO> liveBSEList = icompanyService.getTickerData();
		map.addAttribute("BSESensexValue" ,liveBSEList.get(liveBSEList.size()-1));
		map.addAttribute("LiveBSE", liveBSEList);
		map.addAttribute("gainerAndLosserCommand", new GainerAndLosserCommand());
		return DISPLAYGRAPH;
		
	}


	@RequestMapping(value="graph/details",method=RequestMethod.POST)
	public String CompnyDetails(@RequestParam("companyName") String companyName,ModelMap map){
		List<ActiveCompanyListBO> companyNameList = null;
		if (companyName.contains("(")) {
			companyName = companyName.substring(0, companyName.lastIndexOf('('));	
		}
		companyNameList = icompanyService.getCompanyList(companyName);
		map.addAttribute("companyNameList", companyNameList);
		map.addAttribute("companyName", companyName);
		map.addAttribute("size", companyNameList.size());
		return DISPLAYGRAPHDETAILS;
	}


	@RequestMapping(value="graph/detailsList",method=RequestMethod.POST)
	public String CompnyDetailsDemo(@RequestParam("companyName") String companyName,ModelMap map){
		List<ActiveCompanyListBO> companyNameList = null;
		if (companyName.contains("(")) {
			companyName = companyName.substring(0, companyName.lastIndexOf('('));	
		}
		companyNameList = icompanyService.getCompanyList(companyName);
		map.addAttribute("companyNameList", companyNameList);
		map.addAttribute("companyName", companyName);
		map.addAttribute("size", companyNameList.size());
		return DISPLAYGRAPHDETAILSLIST;
	}


	@RequestMapping(value="gainerAndLoserdisplay",method=RequestMethod.POST)
	public String DispayGainerAndLoser( @ModelAttribute GainerAndLosserCommand gainerAndLosserCommand,ModelMap map){
		Map<String, Object> mapOfValue = icompanyService.getWholeGainerLoser(gainerAndLosserCommand);


		map.addAttribute("Map", mapOfValue);
		return GAINER_OR_LOSER_DISPLAY;
	}

	/*
	 * PREPARED BY :PRIVIL.S.PRAKASH NAME: AUTOCOMPLETE HANDLER PURPOSE: HANDLES
	 * THE AUTOCOMPLETE PROCESS IN THE LOGIN PAGE.
	 */

	@RequestMapping(value = "/", method = RequestMethod.POST)
	public @ResponseBody List<ActiveCompanyListBO> getCompanyName(@RequestParam String companyName) {
		List<ActiveCompanyListBO> companyNameList = null;
		companyNameList = icompanyService.getCompanyList(companyName);
		return companyNameList;

	}


	@RequestMapping(value="/wholecompanydetails", method=RequestMethod.POST)
	public @ResponseBody List<List<CompanyStockDetailsBO>> getCompanyStockPrice(@RequestParam List<String> compnyList,@RequestParam String year,@RequestParam int[] average) throws ParseException{
		List<List<CompanyStockDetailsBO>> companyMovingAverageList=null;
		
//		System.out.println("Company Name : "+compnyList);
		
		companyMovingAverageList=icompanyService.getCompanyMovingAverage(compnyList, year, average);
		return companyMovingAverageList ;

	}

	@RequestMapping(value="/companydetailsQuotes", method=RequestMethod.POST)
	public @ResponseBody List<Object> getCompanyStockPriceQuotes(@RequestParam List<String> compnyList,@RequestParam String year,@RequestParam int[] average) throws ParseException{
		List<List<CompanyStockDetailsBO>> companyMovingAverageList=null;
		CompanyStockDetailsBO companyStockDetailsBO =null;
		List<Object> companyDetailsQuotesList=null;
		companyMovingAverageList=icompanyService.getCompanyMovingAverage(compnyList, year, average);
		companyStockDetailsBO=icompanyService.getlivedataFeeds(compnyList.get(0));
		if (companyStockDetailsBO!=null) {
			companyDetailsQuotesList= icompanyService.getCompanyQuotesCalculation(companyMovingAverageList,companyStockDetailsBO);
			return companyDetailsQuotesList;
		}
		return null;
	}


	@RequestMapping(value="/suggestion", method=RequestMethod.POST)
	public @ResponseBody Map<String, Object> getCompanySuggestion(@RequestParam String companyName) throws ParseException{
		Map<String, Object> suggestion=null;
		suggestion=icompanyService.getCompanySuggestion(companyName);
		if(suggestion!=null){
			return suggestion;
		}else{
			return null;
		}



	}

	@RequestMapping(value="/latestpattern", method=RequestMethod.GET)
	public String LatestPatternReportHome(ModelMap modelMap,HttpServletRequest request){
		List<DailyPatternReportBO> latestPatternList=null;
		latestPatternList=icompanyService.getLatestPatternReport();
		
		Date formingDate=latestPatternList.get(latestPatternList.size()-1).getForming_Date();
		modelMap.addAttribute("formingDate", formingDate);
		modelMap.addAttribute("LatestReport", latestPatternList);
		return LATESTPATTERNREPORT;
	}

	@RequestMapping(value="/getlatestpattern", method=RequestMethod.POST)
	public @ResponseBody List<DailyPatternReportBO> getLatestPatternReport(){
		List<DailyPatternReportBO> getLatestList=null;
		getLatestList=icompanyService.getLatestPatternReport();
		return getLatestList;
	}
	


	
	
	@ModelAttribute()
	public void  getReachUsList( ModelMap modelMap){

		List<String> parameterList = null;

		parameterList=(List<String>) icache.get("period");
		modelMap.addAttribute("period", parameterList);


		List<String> parameterList1 = null;

		parameterList1=(List<String>) icache.get("G_L today");
		modelMap.addAttribute("variation", parameterList1);

		List<String> parameterList2 = null; 

		parameterList2=(List<String>) icache.get("priceRange");
		modelMap.addAttribute("price", parameterList2);

		List<String> parameterList3 = null;

		parameterList3= (List<String>) icache.get("indexrange");
		modelMap.addAttribute("indexrange", parameterList3);

	}
}
