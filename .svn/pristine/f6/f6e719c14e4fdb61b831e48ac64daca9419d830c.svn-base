package com.nivesh.bo;

import java.util.Date;

public class UserLogHistoryBO {
  private String UNAME;
  private Date LAST_LOGIN_DATE_TIME;
  private String IP_ADDR;
  private String SYSTEM_NAME;
public String getSYSTEM_NAME() {
	return SYSTEM_NAME;
}
public void setSYSTEM_NAME(String sYSTEM_NAME) {
	SYSTEM_NAME = sYSTEM_NAME;
}
public String getUNAME() {
	return UNAME;
}
public void setUNAME(String uNAME) {
	UNAME = uNAME;
}
public Date getLAST_LOGIN_DATE_TIME() {
	return LAST_LOGIN_DATE_TIME;
}
public void setLAST_LOGIN_DATE_TIME(Date lAST_LOGIN_DATE_TIME) {
	LAST_LOGIN_DATE_TIME = lAST_LOGIN_DATE_TIME;
}
public String getIP_ADDR() {
	return IP_ADDR;
}
public void setIP_ADDR(String iP_ADDR) {
	IP_ADDR = iP_ADDR;
}

  
  
  
}