public class CompanyDao implements ICompanyDao {
	private JdbcTemplate jdbcTemplate;
	private NamedParameterJdbcTemplate npjt;
	DecimalFormat dfm = new DecimalFormat("#.00");
	public CompanyDao(JdbcTemplate jdbcTemplate,NamedParameterJdbcTemplate npjt) {  //here i add NamedParameterJdbcTemplate npjt 1 march
		super();
		this.jdbcTemplate = jdbcTemplate;
		this.npjt = npjt;   //add this on 1march
	}

	@Override
	public Set<CompanyStockDetailsBO> getCompanyList(String companyCode) {
		return jdbcTemplate.query(AccessorSqlConstant.COMPANY_ACCESSOR_SQL,new Object[]{companyCode},
				new CompanyAccessorExtractor());
	}

	private class CompanyAccessorExtractor implements ResultSetExtractor<Set<CompanyStockDetailsBO>> {

		@Override
		public Set<CompanyStockDetailsBO> extractData(ResultSet rs) throws SQLException, DataAccessException {

			Set<CompanyStockDetailsBO> companyAccessorSet = new LinkedHashSet<CompanyStockDetailsBO>();

			while (rs.next()) {
				CompanyStockDetailsBO companyBO = new CompanyStockDetailsBO();
				companyBO.setStockDate(rs.getDate(1));
				companyBO.setCompanyCode(rs.getInt(2));
				companyBO.setCompanyOpenPrice(rs.getFloat(3));
				companyBO.setCompanyHighPrice(rs.getFloat(4));
				companyBO.setCompanyLowPrice(rs.getFloat(5));
				companyBO.setCompanyClosePrice(rs.getFloat(6));
				companyBO.setCompanyPrevClosePrice(rs.getFloat(7));
				companyBO.setStockVolume(rs.getInt(8));
				companyBO.setCompanyTurnover(rs.getLong(9));

				companyAccessorSet.add(companyBO);

			}
			return companyAccessorSet;

		}

	}


	@Override
	public List<DailyPatternReportBO> getLatestPatternReport() {

		return jdbcTemplate.query(SuggestionReportSqlConstant.GET_LATEST_PATTERN_DATA, new LatestReportExtractor());

	}

	private class LatestReportExtractor implements ResultSetExtractor<List<DailyPatternReportBO>> {

		@Override
		public List<DailyPatternReportBO> extractData(ResultSet rs) throws SQLException, DataAccessException {
			List<DailyPatternReportBO> reportList = null;
			reportList = new ArrayList<DailyPatternReportBO>();
			while (rs.next()) {
				DailyPatternReportBO dailyPatternReportBo = new DailyPatternReportBO();
				dailyPatternReportBo.setCompanyName(rs.getString(1));
				dailyPatternReportBo.setPattern_Name(rs.getString(2));
				dailyPatternReportBo.setSuggestion(rs.getString(3));
				dailyPatternReportBo.setForming_Date(rs.getDate(4));
				//reportBO.setStatus(rs.getString(5));
				reportList.add(dailyPatternReportBo);

			}
			return reportList;
		}
	}








	@Override
	public List<ActiveCompanyListBO> getCompanyData(String companyname) {


		MapSqlParameterSource mapSqlParameterSource=new MapSqlParameterSource();
		mapSqlParameterSource.addValue("COMPANYNAME",companyname.toUpperCase()+"%");
		return npjt.query(PortfolioSqlConstants.SQL_GETCOMPANYNAME,mapSqlParameterSource ,new CompanyNameExtractor());

	}
	private class CompanyNameExtractor implements ResultSetExtractor<List<ActiveCompanyListBO>>{

		@Override
		public List<ActiveCompanyListBO> extractData(ResultSet rs) throws SQLException, DataAccessException {

			List<ActiveCompanyListBO> getCompanyList=new ArrayList<ActiveCompanyListBO>();
			while(rs.next()){
				ActiveCompanyListBO activeCompanyListBO=new ActiveCompanyListBO();


				activeCompanyListBO.setCompanyCode(rs.getInt(1));
				activeCompanyListBO.setCompanyId(rs.getString(2));
				activeCompanyListBO.setCompanyName(rs.getString(3));
				activeCompanyListBO.setCompanyGroup(rs.getString(4));
				activeCompanyListBO.setCompanyFaceValue(rs.getFloat(5));
				activeCompanyListBO.setCompanyIndustry(rs.getString(6));

				getCompanyList.add(activeCompanyListBO);
			}
			return getCompanyList;
		}

	}


	@Override
	public List<ActiveCompanyListBO> getCompanyNameList(String companyName) {
		String companyName1 = companyName+"%";
		return jdbcTemplate.query(LoginSqlConstants.SQL_COMPNAME, new Object[] { companyName1,companyName1,companyName1 },
				new CompanyNameResultSetExtractor());

	}

	private class CompanyNameResultSetExtractor implements ResultSetExtractor<List<ActiveCompanyListBO>> {

		@Override
		public List<ActiveCompanyListBO> extractData(ResultSet rs) throws SQLException, DataAccessException {

			List<ActiveCompanyListBO> getCompanyList = new ArrayList<ActiveCompanyListBO>();
			while (rs.next()) {
				ActiveCompanyListBO companyBO = new ActiveCompanyListBO();
				companyBO.setCompanyName(rs.getString(1));
				companyBO.setCompanyId(rs.getString(3));
				companyBO.setCompanyCode(rs.getInt(2));
				getCompanyList.add(companyBO);

			}
			return getCompanyList;
		}

	}

	@Override
	public List<ActiveCompanyListBO> getCompanyList() {

		return jdbcTemplate.query(LoginSqlConstants.SQL_COMPANYNAME_FOR_TESTING,new CompanyExtractor());

	}

	private class CompanyExtractor implements ResultSetExtractor<List<ActiveCompanyListBO>> {

		@Override
		public List<ActiveCompanyListBO> extractData(ResultSet rs) throws SQLException, DataAccessException {

			List<ActiveCompanyListBO> getCompanyList = new ArrayList<ActiveCompanyListBO>();
			while (rs.next()) {
				ActiveCompanyListBO companyBO = new ActiveCompanyListBO();
				companyBO.setCompanyName(rs.getString(1));
				getCompanyList.add(companyBO);

			}
			return getCompanyList;
		}

	}
	
			
