package com.nivesh.bo;

import java.util.Date;

public class CompanyStockDetailsBO {
	private Date stockDate;
	private int companyCode;
	private String companyId;
	private String companyGroup;
	private String companyType;
	private Float companyOpenPrice;
	private Float companyHighPrice;
	private Float companyLowPrice;
	private Float companyClosePrice;
	private Float companyLastPrice;
	private Float companyPrevClosePrice;
	private int stockTrades;
	private int stockVolume;
	private long companyTurnover;
	private Float movingAverage;
	
	
	
	
	
	public Float getMovingAverage() {
		return movingAverage;
	}
	public void setMovingAverage(Float movingAverage) {
		this.movingAverage = movingAverage;
	}
	public Date getStockDate() {
		return stockDate;
	}
	public void setStockDate(Date stockDate) {
		this.stockDate = stockDate;
	}
	public int getCompanyCode() {
		return companyCode;
	}
	public void setCompanyCode(int companyCode) {
		this.companyCode = companyCode;
	}
	public String getCompanyId() {
		return companyId;
	}
	public void setCompanyId(String companyId) {
		this.companyId = companyId;
	}
	public String getCompanyGroup() {
		return companyGroup;
	}
	public void setCompanyGroup(String companyGroup) {
		this.companyGroup = companyGroup;
	}
	public String getCompanyType() {
		return companyType;
	}
	public void setCompanyType(String companyType) {
		this.companyType = companyType;
	}
	public Float getCompanyOpenPrice() {
		return companyOpenPrice;
	}
	public void setCompanyOpenPrice(Float companyOpenPrice) {
		this.companyOpenPrice = companyOpenPrice;
	}
	public Float getCompanyHighPrice() {
		return companyHighPrice;
	}
	public void setCompanyHighPrice(Float companyHighPrice) {
		this.companyHighPrice = companyHighPrice;
	}
	public Float getCompanyLowPrice() {
		return companyLowPrice;
	}
	public void setCompanyLowPrice(Float companyLowPrice) {
		this.companyLowPrice = companyLowPrice;
	}
	public Float getCompanyClosePrice() {
		return companyClosePrice;
	}
	public void setCompanyClosePrice(Float companyClosePrice) {
		this.companyClosePrice = companyClosePrice;
	}
	public Float getCompanyLastPrice() {
		return companyLastPrice;
	}
	public void setCompanyLastPrice(Float companyLastPrice) {
		this.companyLastPrice = companyLastPrice;
	}
	public Float getCompanyPrevClosePrice() {
		return companyPrevClosePrice;
	}
	public void setCompanyPrevClosePrice(Float companyPrevClosePrice) {
		this.companyPrevClosePrice = companyPrevClosePrice;
	}
	public int getStockTrades() {
		return stockTrades;
	}
	public void setStockTrades(int stockTrades) {
		this.stockTrades = stockTrades;
	}
	public int getStockVolume() {
		return stockVolume;
	}
	public void setStockVolume(int stockVolume) {
		this.stockVolume = stockVolume;
	}
	public long getCompanyTurnover() {
		return companyTurnover;
	}
	public void setCompanyTurnover(long companyTurnover) {
		this.companyTurnover = companyTurnover;
	}
	@Override
	public String toString() {
		return "CompanyStockDetailsBO [stockDate=" + stockDate + ", companyCode=" + companyCode + ", companyId="
				+ companyId + ", companyGroup=" + companyGroup + ", companyType=" + companyType + ", companyOpenPrice="
				+ companyOpenPrice + ", companyHighPrice=" + companyHighPrice + ", companyLowPrice=" + companyLowPrice
				+ ", companyClosePrice=" + companyClosePrice + ", companyLastPrice=" + companyLastPrice
				+ ", companyPrevClosePrice=" + companyPrevClosePrice + ", stockTrades=" + stockTrades + ", stockVolume="
				+ stockVolume + ", companyTurnover=" + companyTurnover + ", movingAverage=" + movingAverage + "]";
	}

	

}
