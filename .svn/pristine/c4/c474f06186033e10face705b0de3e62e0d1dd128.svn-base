package com.nivesh.bo;

import java.util.Date;

public class AlgoEfficacyBO {

	private int noOfMonth;
	private Date searchdate;
	private Date prevSearchdate;
	public Date getPrevSearchdate() {
		return prevSearchdate;
	}
	public void setPrevSearchdate(Date prevSearchdate) {
		this.prevSearchdate = prevSearchdate;
	}

	private Date givendate;
	private Date prevgivendate;
	private int sc_code;
	


	public int getSc_code() {
		return sc_code;
	}
	public void setSc_code(int sc_code) {
		this.sc_code = sc_code;
	}

    private float bseBackPrice;
    private float bsePrice;
	public float getBseBackPrice() {
		return bseBackPrice;
	}
	public void setBseBackPrice(float bseBackPrice) {
		this.bseBackPrice = bseBackPrice;
	}
	public float getBsePrice() {
		return bsePrice;
	}
	public void setBsePrice(float bsePrice) {
		this.bsePrice = bsePrice;
	}

	private String companyname;
	private String pattern_name;
	private String suggestion;
	private Date forming_date;
	private float backPrice; 
	private float todayClosePrice;
	private float acPer;
	private float bseacPer;
	public float getBseacPer() {
		return bseacPer;
	}
	public void setBseacPer(float bseacPer) {
		this.bseacPer = bseacPer;
	}
	public int getNoOfMonth() {
		return noOfMonth;
	}
	public void setNoOfMonth(int noOfMonth) {
		this.noOfMonth = noOfMonth;
	}
	
	public Date getSearchdate() {
		return searchdate;
	}
	public void setSearchdate(Date searchdate) {
		this.searchdate = searchdate;
	}
	
	public Date getGivendate() {
		return givendate;
	}
	public void setGivendate(Date givendate) {
		this.givendate = givendate;
	}
	public Date getPrevgivendate() {
		return prevgivendate;
	}
	public void setPrevgivendate(Date prevgivendate) {
		this.prevgivendate = prevgivendate;
	}
	
	public String getCompanyname() {
		return companyname;
	}
	public void setCompanyname(String companyname) {
		this.companyname = companyname;
	}
	public String getPattern_name() {
		return pattern_name;
	}
	public void setPattern_name(String pattern_name) {
		this.pattern_name = pattern_name;
	}
	public String getSuggestion() {
		return suggestion;
	}
	public void setSuggestion(String suggestion) {
		this.suggestion = suggestion;
	}
	public Date getForming_date() {
		return forming_date;
	}
	public void setForming_date(Date forming_date) {
		this.forming_date = forming_date;
	}
	public float getBackPrice() {
		return backPrice;
	}
	public void setBackPrice(float backPrice) {
		this.backPrice = backPrice;
	}
	public float getTodayClosePrice() {
		return todayClosePrice;
	}
	public void setTodayClosePrice(float todayClosePrice) {
		this.todayClosePrice = todayClosePrice;
	}
	public float getAcPer() {
		return acPer;
	}
	public void setAcPer(float acPer) {
		this.acPer = acPer;
	}
	
	
	@Override
	public String toString() {
		return "AlgoEfficacyBO [noOfMonth=" + noOfMonth + ", searchdate=" + searchdate + ", prevSearchdate="
				+ prevSearchdate + ", givendate=" + givendate + ", prevgivendate=" + prevgivendate + ", sc_code="
				+ sc_code + ", bseBackPrice=" + bseBackPrice + ", bsePrice=" + bsePrice + ", companyname=" + companyname
				+ ", pattern_name=" + pattern_name + ", suggestion=" + suggestion + ", forming_date=" + forming_date
				+ ", backPrice=" + backPrice + ", todayClosePrice=" + todayClosePrice + ", acPer=" + acPer
				+ ", bseacPer=" + bseacPer + "]";
	}
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
}
