package com.nivesh.dto.payment;

public class Refund {
	@org.codehaus.jackson.annotate.JsonProperty("refund")
	private Refund_request refund;

 	
	public Refund_request getRefund() {
		return refund;
	}

	public void setRefund(Refund_request refund) {
		this.refund = refund;
	}

	@org.codehaus.jackson.annotate.JsonProperty("success")
	private java.lang.Boolean success;

 	public void setSuccess(java.lang.Boolean success) {
		this.success = success;
	}

	public java.lang.Boolean getSuccess() {
		return success;
	}

	@Override
	public String toString() {
		return "Payment [payment_request=" + refund + ", success="
				+ success + "]";
	}

}
