package com.nivesh.bo;

import java.io.Serializable;

import com.nivesh.util.AllAnnotation;



public class MaxIdSetupDataBO implements Serializable{
		/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
		@AllAnnotation.IdAnnotation
		private int id;
		private String tableName;
		private String tableIdLabel;
		public int getId() {
			return id;
		}
		public void setId(int id) {
			this.id = id;
		}
		public String getTableName() {
			return tableName;
		}
		public void setTableName(String tableName) {
			this.tableName = tableName;
		}
		public String getTableIdLabel() {
			return tableIdLabel;
		}
		public void setTableIdLabel(String tableIdLabel) {
			this.tableIdLabel = tableIdLabel;
		}
		
}
